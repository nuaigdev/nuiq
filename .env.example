# =============================================================================
# NuIQ — environment template. Copy to .env.local and fill in.
# This file is gitignored. Never commit it.
#
# DEPLOYING TO VERCEL
#   Copy every variable in SECTION 1 into Vercel exactly as-is
#   (Project -> Settings -> Environment Variables).
#   Do NOT copy SECTION 2 — read the notes there.
# =============================================================================

# --- SECTION 1: copy these to Vercel unchanged -------------------------------

# Which client this deployment serves. Selects its document in the config store.
CLIENT_ID=

# Signs the NextAuth session cookie.
AUTH_SECRET=

# Entra app registration client secret. Rotate this before production.
ENTRA_CLIENT_SECRET=

# Who may add or remove dashboards. Comma-separated. Enforced server-side and
# fails closed: empty means nobody is an admin.
ADMIN_EMAILS=

# Required behind a proxy, which includes Vercel.
AUTH_TRUST_HOST=true

# Where client configuration lives.
CONFIG_STORE_PROVIDER=vercel-blob
CONFIG_STORE_PREFIX=clients
CONFIG_CACHE_TTL_SECONDS=30

# Forces Entra to show the consent screen on the next sign-in. Sign-in only
# requests Power BI scopes, so adding a Fabric permission in the portal never
# prompts on its own and the grant can go stale. Set to true, sign in once,
# then remove it.
# AUTH_FORCE_CONSENT=true

# --- SECTION 2: do NOT copy these to Vercel ----------------------------------

# Vercel sets this automatically when a Blob store is connected to the project.
# Setting it by hand in Vercel would shadow the real one.
# Locally, populate it with:  vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# The deployment's own origin, so it differs per environment.
#   local  : leave unset — NextAuth infers http://localhost:3000
#   Vercel : set to https://<your-production-domain> in the Vercel dashboard
# AUTH_URL=
