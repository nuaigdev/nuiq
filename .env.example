# NuIQ environment. Copy to .env.local for local development.
# .env.local is gitignored — never commit real values (CLAUDE.md §3).

# Which client this instance serves. Selects that client's document in the
# configuration store.
CLIENT_ID=kestrelbrook

# Signs the NextAuth session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Client secret for the Entra app registration named by the client's config
# (entraClientId). On Vercel this is a project environment variable; for
# production client deployments on Azure it comes from that client's Key Vault
# via managed identity. Never checked in, never shared between clients.
ENTRA_CLIENT_SECRET=

# Needed when the app is served behind a proxy (Vercel, Azure Container Apps).
AUTH_TRUST_HOST=true
# Production origin, e.g. https://nuiq.vercel.app. Required on Vercel so
# NextAuth builds callback URLs against the real host.
# AUTH_URL=

# Who may add or remove dashboards, comma-separated. Enforced server-side.
# Empty means nobody — this fails closed rather than open.
ADMIN_EMAILS=

# --- Configuration store (CLAUDE.md §3) --------------------------------------
# Where this client's tenant-config.json lives. No default: a deployment must
# say where its configuration is rather than having one guessed.
CONFIG_STORE_PROVIDER=vercel-blob
# Key prefix inside the store. Defaults to "clients".
CONFIG_STORE_PREFIX=clients
# Seconds a loaded config is reused before re-reading. Defaults to 30.
CONFIG_CACHE_TTL_SECONDS=30
# Injected automatically by Vercel when a Blob store is linked to the project.
# Locally: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
