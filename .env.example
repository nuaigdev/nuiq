# NuIQ environment. Copy to .env.local for local development.
# .env.local is gitignored — never commit real values (CLAUDE.md §3).

# Which client this instance serves. Selects config/<CLIENT_ID>/tenant.json.
CLIENT_ID=kestrelbrook

# Signs the NextAuth session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Client secret for the Entra app registration named by tenant.json
# (entraClientId). In a deployment this comes from that client's Key Vault via
# managed identity — it is never checked in and never shared between clients.
ENTRA_CLIENT_SECRET=

# Needed when the app is served behind a proxy (e.g. Azure Container Apps).
# AUTH_TRUST_HOST=true
